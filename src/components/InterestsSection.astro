---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';

const interests = (await getCollection('interests')).sort((a, b) => a.data.order - b.data.order);
---

<section id="interests" class="interests">
  <SectionHeader title="Interests" />

  <ul class="row" role="list">
    {interests.map((entry) => (
      <li>
        <Icon name={entry.data.icon} aria-hidden="true" />
        <span>{entry.data.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .interests {
    position: relative;
    padding: 0 var(--content-gutter) calc(var(--section-padding-y) + 1rem);
    background:
      linear-gradient(112deg, rgb(0 101 101 / 0.92) 0 34%, transparent 34%),
      var(--color-dark);
    color: #fff;
    clip-path: polygon(0 2.5rem, 24% 0, 100% 1.4rem, 100% calc(100% - 1.5rem), 76% 100%, 0 calc(100% - 0.6rem));
  }

  .interests :global(.section-header),
  .row {
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .interests :global(.section-header h2) { color: #fff; }
  .interests :global(.section-header p) { color: #b7dcda; }

  .row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: clamp(1.25rem, 4vw, 3rem);
  }

  li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  li [data-icon] {
    font-size: 2.2rem;
    color: #b7dcda;
  }

  span {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.72);
  }

  @media (max-width: 34rem) {
    .row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
