---
import { Icon } from 'astro-icon/components';
import site from '../data/site.json';

// Stubbed until a form provider is chosen. With no endpoint the form still
// works: submitting composes a mail message instead of POSTing anywhere.
const endpoint = site.contact.endpoint as string | null;
---

<section id="contact" class="contact">
  <span id="project-section" class="legacy-anchor" aria-hidden="true"></span>
  <div class="panels">
    <div class="panel start">
      <p class="kicker">Have a problem worth solving?</p>
      <h2>Let's build something useful</h2>
      <button type="button" class="cta" data-open-contact data-intent="project">
        <span>Start a conversation</span>
      </button>
    </div>

    <div class="panel message">
      <p class="kicker">Making a game or a tool?</p>
      <h2>Let's compare notes</h2>
      <button type="button" class="cta" data-open-contact data-intent="message">
        <span>Talk game development</span>
      </button>
    </div>
  </div>
</section>

<dialog id="contact-dialog" class="dialog" aria-labelledby="contact-heading">
  <button type="button" class="close" aria-label="Close">
    <Icon name="fa6-solid:xmark" aria-hidden="true" />
  </button>

  <div class="head">
    <p class="kicker">Let's take the next step together</p>
    <h2 id="contact-heading">Start your project</h2>
  </div>

  <form
    class="form"
    method={endpoint ? 'post' : 'dialog'}
    action={endpoint ?? undefined}
    data-fallback={endpoint ? undefined : `mailto:${site.email}`}
  >
    <p class="field">
      <label for="c-name">Name <span aria-hidden="true">*</span></label>
      <input id="c-name" name="name" type="text" required autocomplete="name" />
    </p>
    <p class="field">
      <label for="c-company">Company</label>
      <input id="c-company" name="company" type="text" autocomplete="organization" />
    </p>
    <p class="field">
      <label for="c-email">Email <span aria-hidden="true">*</span></label>
      <input id="c-email" name="email" type="email" required autocomplete="email" />
    </p>
    <p class="field">
      <label for="c-phone">Telephone</label>
      <input id="c-phone" name="phone" type="tel" autocomplete="tel" />
    </p>
    <p class="field wide">
      <label for="c-subject">Subject</label>
      <input id="c-subject" name="subject" type="text" />
    </p>
    <p class="field wide">
      <label for="c-message">Message <span aria-hidden="true">*</span></label>
      <textarea id="c-message" name="message" rows="5" required></textarea>
    </p>

    <p class="submit">
      <button type="submit">Send</button>
    </p>

    {!endpoint && (
      <p class="note">
        No form service is wired up yet, so this opens your mail app with the
        details filled in. Set <code>contact.endpoint</code> in
        <code>src/data/site.json</code> to post it instead.
      </p>
    )}
  </form>
</dialog>

<style>
  .contact {
    position: relative;
    margin-top: -2rem;
    padding-block: calc(var(--section-padding-y) + 2rem) var(--section-padding-y);
    background: var(--color-dark-deep);
    clip-path: polygon(0 var(--section-slant), 27% 0, 100% clamp(1.2rem, 3vw, 3rem), 100% 100%, 0 100%);
  }

  .panels {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--content-gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }

  .panel {
    min-height: 26rem;
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .start {
    z-index: 1;
    margin-right: -4rem;
    padding-right: clamp(5rem, 9vw, 8rem);
    color: #fff;
    background: var(--color-accent);
    clip-path: polygon(0 0, 100% 0, calc(100% - 4rem) 100%, 0 100%);
  }
  .message {
    padding-left: clamp(6rem, 10vw, 9rem);
    color: var(--color-ink);
    background: var(--color-surface-raised);
    clip-path: polygon(4rem 0, 100% 0, 100% 100%, 0 100%);
  }

  .kicker {
    font-family: var(--font-ui);
    font-size: clamp(0.85rem, 1.6vw, 1.125rem);
    color: inherit;
    opacity: 0.72;
  }

  .panel h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin-block: 0.75rem clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.05;
  }

  .cta {
    display: inline-block;
    border: 0;
    cursor: pointer;
    padding: 0.9rem 1.2rem;
    padding-right: 1.8rem;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 100%, 0 100%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .cta span { display: block; }

  .start .cta { background: #fff; color: var(--color-accent-dark); }
  .start .cta:hover, .start .cta:focus-visible { background: var(--color-dark); color: #fff; }

  .message .cta { background: var(--color-ink); color: #fff; }
  .message .cta:hover, .message .cta:focus-visible { background: var(--color-accent-warm); }

  @media (max-width: 46rem) {
    .contact { clip-path: polygon(0 2rem, 28% 0, 100% 1rem, 100% 100%, 0 100%); }
    .panels { grid-template-columns: 1fr; }
    .panel { min-height: 20rem; }
    .start { margin: 0 0 -2rem; padding: 2.5rem 2rem 4rem; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 2rem), 30% 100%, 0 calc(100% - 1rem)); }
    .message { padding: 4.5rem 2rem 2.5rem; clip-path: polygon(0 2rem, 70% 0, 100% 1rem, 100% 100%, 0 100%); }
  }

  /* --- Dialog ----------------------------------------------------- */

  .dialog {
    border: 0;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    max-width: min(94vw, 46rem);
    width: 100%;
    background: var(--color-surface-raised);
    color: var(--color-ink);
    position: relative;
  }

  .dialog::backdrop { background: rgb(24 20 19 / 0.9); }

  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: 0;
    font-size: 1.25rem;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0.4rem;
  }

  .close:hover { color: var(--color-crimson); }

  .head { margin-bottom: 1.75rem; }
  .head .kicker { color: var(--color-muted); }

  .head h2 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    text-transform: uppercase;
    margin-top: 0.35rem;
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .field { display: flex; flex-direction: column; gap: 0.35rem; margin: 0; }
  .field.wide, .submit, .note { grid-column: 1 / -1; }

  label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  label span { color: var(--color-crimson); }

  input, textarea {
    font-family: var(--font-ui);
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    color: var(--color-ink);
    width: 100%;
  }

  input:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--color-crimson);
    outline-offset: 1px;
    border-color: transparent;
  }

  .submit { margin: 0; }

  .submit button {
    border: 0;
    cursor: pointer;
    background: var(--color-crimson);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 0.9rem 2rem;
  }

  .submit button:hover, .submit button:focus-visible { background: var(--color-ink); }

  .note {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-muted);
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
  }

  .note code {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    background: var(--color-surface-sunk);
    padding: 0.05em 0.3em;
  }

  @media (max-width: 34rem) {
    .form { grid-template-columns: 1fr; }
  }
  /* Anchors from the 2017 site, kept so old links and bookmarks still land. */
  .legacy-anchor {
    display: block;
    height: 0;
    scroll-margin-top: var(--header-height);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#contact-dialog');
  const heading = document.querySelector<HTMLHeadingElement>('#contact-heading');
  const form = dialog?.querySelector<HTMLFormElement>('.form');
  const subject = dialog?.querySelector<HTMLInputElement>('#c-subject');

  document.querySelectorAll<HTMLButtonElement>('[data-open-contact]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog) return;
      const project = button.dataset.intent === 'project';
      if (heading) heading.textContent = project ? 'Start your project' : 'Send a message';
      if (subject && !subject.value) subject.value = project ? 'Project enquiry' : '';
      dialog.showModal();
    });
  });

  dialog?.querySelector('.close')?.addEventListener('click', () => dialog.close());

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  // With no endpoint configured, compose a mail message from the fields.
  form?.addEventListener('submit', (event) => {
    const fallback = form.dataset.fallback;
    if (!fallback) return;

    event.preventDefault();
    const data = new FormData(form);
    const lines = ['name', 'company', 'email', 'phone']
      .map((key) => {
        const value = String(data.get(key) ?? '').trim();
        return value ? `${key[0].toUpperCase()}${key.slice(1)}: ${value}` : null;
      })
      .filter(Boolean);

    const body = [...lines, '', String(data.get('message') ?? '')].join('\n');
    const subjectLine = String(data.get('subject') ?? '').trim() || 'Message from patrickbarnhardt.info';

    window.location.href =
      `${fallback}?subject=${encodeURIComponent(subjectLine)}&body=${encodeURIComponent(body)}`;
    dialog?.close();
  });
</script>
