---
import { Icon } from 'astro-icon/components';
import site from '../data/site.json';

const endpoint = import.meta.env.DEV
  ? 'http://localhost:8787/'
  : site.contact.endpoint;
const turnstileSiteKey = import.meta.env.DEV
  ? '1x00000000000000000000AA'
  : site.contact.turnstileSiteKey;
---

<section id="contact" class="contact">
  <span id="project-section" class="legacy-anchor" aria-hidden="true"></span>
  <div class="panels">
    <div class="panel start">
      <p class="kicker">Got something broken or half-built?</p>
      <h2>Tell me about it</h2>
      <button type="button" class="cta" data-open-contact data-intent="project">
        <span>Start a conversation</span>
      </button>
    </div>

    <div class="panel message">
      <p class="kicker">Making a game or a tool?</p>
      <h2>Let's compare notes</h2>
      <button type="button" class="cta" data-open-contact data-intent="message">
        <span>Talk game development</span>
      </button>
    </div>
  </div>
</section>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<dialog id="contact-dialog" class="dialog" aria-labelledby="contact-heading">
  <button type="button" class="close" aria-label="Close">
    <Icon name="fa6-solid:xmark" aria-hidden="true" />
  </button>

  <div class="head">
    <p class="kicker" id="contact-kicker">A few fields, then it becomes an email</p>
    <h2 id="contact-heading">What do you need?</h2>
    <p class="intro" id="contact-intro">
      Tell me what you are trying to make, improve, or untangle.
    </p>
  </div>

  <form
    class="form"
    method="post"
    action={endpoint}
  >
    <input id="c-intent" name="Inquiry type" type="hidden" value="Project enquiry" />

    <p class="trap" aria-hidden="true">
      <label for="c-website">Leave this field empty</label>
      <input id="c-website" name="Website" type="text" tabindex="-1" autocomplete="off" />
    </p>

    <p class="field">
      <label for="c-name">Name <span aria-hidden="true">*</span></label>
      <input id="c-name" name="name" type="text" required autocomplete="name" />
    </p>
    <p class="field">
      <label for="c-email">Email <span aria-hidden="true">*</span></label>
      <input id="c-email" name="email" type="email" required autocomplete="email" />
    </p>

    <p class="field" data-intent-field="project">
      <label for="c-company">Company or organization</label>
      <input id="c-company" name="Company or organization" type="text" autocomplete="organization" />
    </p>
    <p class="field" data-intent-field="project">
      <label for="c-phone">Telephone</label>
      <input id="c-phone" name="Telephone" type="tel" autocomplete="tel" />
    </p>
    <p class="field" data-intent-field="project">
      <label for="c-project-type">What can I help with?</label>
      <select id="c-project-type" name="Project type">
        <option value="" selected>Select one</option>
        <option>Website or web application</option>
        <option>Business system or integration</option>
        <option>Developer tooling or workflow</option>
        <option>Something else</option>
      </select>
    </p>
    <p class="field" data-intent-field="project">
      <label for="c-timeline">Ideal timing</label>
      <select id="c-timeline" name="Ideal timing">
        <option value="" selected>Flexible or not sure yet</option>
        <option>As soon as possible</option>
        <option>Within 1–3 months</option>
        <option>Within 3–6 months</option>
        <option>More than 6 months out</option>
      </select>
    </p>

    <p class="field" data-intent-field="game" hidden>
      <label for="c-studio">Studio or team</label>
      <input id="c-studio" name="Studio or team" type="text" autocomplete="organization" disabled />
    </p>
    <p class="field" data-intent-field="game" hidden>
      <label for="c-project-link">Project or build link</label>
      <input id="c-project-link" name="Project or build link" type="url" inputmode="url" placeholder="https://" disabled />
    </p>
    <p class="field" data-intent-field="game" hidden>
      <label for="c-game-topic">What should we compare notes on?</label>
      <select id="c-game-topic" name="Game development topic" disabled>
        <option value="" selected>Select one</option>
        <option>Unreal Engine</option>
        <option>Gameplay systems</option>
        <option>Tools and pipeline</option>
        <option>Technical design</option>
        <option>Independent development</option>
        <option>Something else</option>
      </select>
    </p>
    <p class="field" data-intent-field="game" hidden>
      <label for="c-game-stage">Project stage</label>
      <select id="c-game-stage" name="Project stage" disabled>
        <option value="" selected>Select one</option>
        <option>Exploring an idea</option>
        <option>Prototype</option>
        <option>In production</option>
        <option>Preparing to ship</option>
        <option>Post-launch</option>
        <option>No current project</option>
      </select>
    </p>
    <p class="field wide">
      <label for="c-subject">Subject</label>
      <input id="c-subject" name="Subject" type="text" placeholder="A quick summary" />
    </p>
    <p class="field wide">
      <label for="c-message" id="contact-message-label">
        What are you hoping to build? <span aria-hidden="true">*</span>
      </label>
      <textarea
        id="c-message"
        name="Message"
        rows="5"
        required
        placeholder="A little context, the outcome you need, and where things stand today."
      ></textarea>
    </p>

    <div class="turnstile-field">
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-action="portfolio-contact"
        data-theme="auto"
      ></div>
    </div>

    <p class="submit">
      <button type="submit" id="contact-submit">Send project enquiry</button>
    </p>

    <p class="note">
      Your message is sent securely and delivered directly to
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </form>
</dialog>

<style>
  .contact {
    position: relative;
    margin-top: -2rem;
    padding-block: calc(var(--section-padding-y) + 2rem) var(--section-padding-y);
    background: var(--color-dark-deep);
    clip-path: polygon(0 var(--section-slant), 27% 0, 100% clamp(1.2rem, 3vw, 3rem), 100% 100%, 0 100%);
  }

  .panels {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--content-gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }

  .panel {
    min-height: 26rem;
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .start {
    z-index: 1;
    margin-right: -4rem;
    padding-right: clamp(5rem, 9vw, 8rem);
    color: #fff;
    background: var(--color-accent);
    clip-path: polygon(0 0, 100% 0, calc(100% - 4rem) 100%, 0 100%);
  }
  .message {
    padding-left: clamp(6rem, 10vw, 9rem);
    color: var(--color-ink);
    background: var(--color-surface-raised);
    clip-path: polygon(4rem 0, 100% 0, 100% 100%, 0 100%);
  }

  .kicker {
    font-family: var(--font-ui);
    font-size: clamp(0.85rem, 1.6vw, 1.125rem);
    color: inherit;
    opacity: 0.72;
  }

  .panel h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin-block: 0.75rem clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.05;
  }

  .cta {
    display: inline-block;
    border: 0;
    cursor: pointer;
    padding: 0.9rem 1.2rem;
    padding-right: 1.8rem;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 100%, 0 100%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .cta span { display: block; }

  .start .cta { background: #fff; color: var(--color-accent-dark); }
  .start .cta:hover, .start .cta:focus-visible { background: var(--color-dark); color: #fff; }

  .message .cta { background: var(--color-ink); color: #fff; }
  .message .cta:hover, .message .cta:focus-visible { background: var(--color-accent-warm); }

  @media (max-width: 46rem) {
    .contact { clip-path: polygon(0 2rem, 28% 0, 100% 1rem, 100% 100%, 0 100%); }
    .panels { grid-template-columns: 1fr; }
    .panel { min-height: 20rem; }
    .start { margin: 0 0 -2rem; padding: 2.5rem 2rem 4rem; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 2rem), 30% 100%, 0 calc(100% - 1rem)); }
    .message { padding: 4.5rem 2rem 2.5rem; clip-path: polygon(0 2rem, 70% 0, 100% 1rem, 100% 100%, 0 100%); }
  }

  /* --- Dialog ----------------------------------------------------- */

  .dialog {
    border: 0;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    max-width: min(94vw, 46rem);
    width: 100%;
    background: var(--color-surface-raised);
    color: var(--color-ink);
    position: relative;
  }

  .dialog::backdrop { background: rgb(24 20 19 / 0.9); }

  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: 0;
    font-size: 1.25rem;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0.4rem;
  }

  .close:hover { color: var(--color-crimson); }

  .head { margin-bottom: 1.75rem; }
  .head .kicker { color: var(--color-muted); }

  .head h2 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    text-transform: uppercase;
    margin-top: 0.35rem;
  }

  .intro {
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0.75rem 0 0;
    max-width: 52ch;
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .field { display: flex; flex-direction: column; gap: 0.35rem; margin: 0; }
  .field.wide, .turnstile-field, .submit, .note { grid-column: 1 / -1; }

  .turnstile-field {
    min-height: 4.1rem;
    display: flex;
    align-items: center;
  }

  label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  label span { color: var(--color-crimson); }

  input, textarea, select {
    font-family: var(--font-ui);
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    color: var(--color-ink);
    width: 100%;
  }

  select { min-height: 2.85rem; }

  input:focus-visible, textarea:focus-visible, select:focus-visible {
    outline: 2px solid var(--color-crimson);
    outline-offset: 1px;
    border-color: transparent;
  }

  .submit { margin: 0; }

  .submit button {
    border: 0;
    cursor: pointer;
    background: var(--color-crimson);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 0.9rem 2rem;
  }

  .submit button:hover, .submit button:focus-visible { background: var(--color-ink); }

  .note {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-muted);
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
  }

  .note a { color: inherit; }

  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .form { grid-template-columns: 1fr; }
  }
  /* Anchors from the 2017 site, kept so old links and bookmarks still land. */
  .legacy-anchor {
    display: block;
    height: 0;
    scroll-margin-top: var(--header-height);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#contact-dialog');
  const heading = document.querySelector<HTMLHeadingElement>('#contact-heading');
  const kicker = document.querySelector<HTMLParagraphElement>('#contact-kicker');
  const intro = document.querySelector<HTMLParagraphElement>('#contact-intro');
  const form = dialog?.querySelector<HTMLFormElement>('.form');
  const subject = dialog?.querySelector<HTMLInputElement>('#c-subject');
  const messageLabel = dialog?.querySelector<HTMLLabelElement>('#contact-message-label');
  const message = dialog?.querySelector<HTMLTextAreaElement>('#c-message');
  const intentInput = dialog?.querySelector<HTMLInputElement>('#c-intent');
  const submitButton = dialog?.querySelector<HTMLButtonElement>('#contact-submit');
  const intentFields = dialog?.querySelectorAll<HTMLElement>('[data-intent-field]');

  type ContactIntent = 'project' | 'game';

  const content = {
    project: {
      kicker: "Let's take the next step together",
      heading: 'Start your project',
      intro: 'Tell me what you are trying to make, improve, or untangle.',
      subjectPlaceholder: 'A quick summary',
      messageLabel: 'What are you hoping to build?',
      messagePlaceholder: 'A little context, the outcome you need, and where things stand today.',
      intent: 'Project enquiry',
      submit: 'Send project enquiry',
    },
    game: {
      kicker: 'Making games is better with good company',
      heading: 'Talk game development',
      intro: 'Share what you are working through, or just say hello to a fellow game developer.',
      subjectPlaceholder: 'What would you like to talk about?',
      messageLabel: 'What would you like to compare notes on?',
      messagePlaceholder: 'Tell me about the project, problem, or idea that is on your mind.',
      intent: 'Game development conversation',
      submit: 'Send game dev message',
    },
  } satisfies Record<ContactIntent, Record<string, string>>;

  function setIntent(intent: ContactIntent) {
    const copy = content[intent];
    if (heading) heading.textContent = copy.heading;
    if (kicker) kicker.textContent = copy.kicker;
    if (intro) intro.textContent = copy.intro;
    if (subject) subject.placeholder = copy.subjectPlaceholder;
    if (messageLabel) {
      messageLabel.replaceChildren(document.createTextNode(`${copy.messageLabel} `));
      const required = document.createElement('span');
      required.setAttribute('aria-hidden', 'true');
      required.textContent = '*';
      messageLabel.append(required);
    }
    if (message) message.placeholder = copy.messagePlaceholder;
    if (intentInput) intentInput.value = copy.intent;
    if (submitButton) submitButton.textContent = copy.submit;

    intentFields?.forEach((field) => {
      const visible = field.dataset.intentField === intent;
      field.hidden = !visible;
      field.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
        .forEach((control) => { control.disabled = !visible; });
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open-contact]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog) return;
      const intent: ContactIntent = button.dataset.intent === 'project' ? 'project' : 'game';
      setIntent(intent);
      dialog.showModal();
    });
  });

  dialog?.querySelector('.close')?.addEventListener('click', () => dialog.close());

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  form?.addEventListener('submit', () => {
    if (!submitButton || !form.checkValidity()) return;
    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
  });
</script>
