---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import codeImage from '../assets/images/slider/headerimage.png';
import headshot from '../assets/images/patrick-headshot.png';
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="code-backdrop"
    src={codeImage}
    alt=""
    widths={[900, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="inner">
    <div class="copy">
      <p class="eyebrow">Software developer <span>·</span> Independent game developer</p>
      <h1 id="hero-title">Building dependable systems and interactive worlds.</h1>
      <p class="intro">
        I'm Patrick Barnhardt. Professionally, I build and support software,
        Salesforce solutions, and web platforms. Independently, I create
        Unreal Engine tools, gameplay systems, and original games.
      </p>

      <div class="actions">
        <a class="primary" href="#selected-work">View selected work</a>
        <a class="secondary" href="/resume">View resumé <span aria-hidden="true">→</span></a>
      </div>

      <ul class="focus" role="list" aria-label="Areas of focus">
        <li>Salesforce &amp; business platforms</li>
        <li>Web systems &amp; tools</li>
        <li>Unreal Engine &amp; gameplay</li>
      </ul>
    </div>

    <figure class="portrait">
      <div class="frame">
        <Image
          src={headshot}
          alt="Patrick Barnhardt"
          widths={[420, 640, 820]}
          sizes="(min-width: 56rem) 38vw, 82vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>Currently building</span>
        <strong>One Man's Poison</strong>
        <small>Original game · Unreal Engine 5</small>
      </figcaption>
    </figure>
  </div>

  <a class="scroll" href="#capabilities">
    <span>Explore both sides of the work</span>
    <Icon name="fa6-solid:arrow-down" aria-hidden="true" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    background: var(--color-dark-deep);
    padding: clamp(3.5rem, 7vw, 6.5rem) var(--content-gutter) clamp(4rem, 7vw, 6rem);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.4rem), 68% 100%, 0 calc(100% - 0.7rem));
  }

  .code-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    filter: saturate(0.7) contrast(1.15);
    z-index: -3;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 82% 42%, rgb(0 101 101 / 0.28), transparent 38%),
      linear-gradient(90deg, rgb(24 22 23 / 0.99) 0 38%, rgb(24 22 23 / 0.8) 68%, rgb(24 22 23 / 0.94) 100%);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.42rem;
    background: linear-gradient(90deg, var(--color-accent) 0 68%, var(--color-accent-warm) 68%);
    clip-path: polygon(0 0, 100% 55%, 100% 100%, 0 100%);
  }

  .inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.7fr);
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: center;
  }

  .copy { max-width: 45rem; }

  .eyebrow {
    color: #9fd1cf;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow span { color: var(--color-accent-warm); padding-inline: 0.3rem; }

  h1 {
    max-width: 15ch;
    margin-top: 1.1rem;
    font-size: clamp(2.8rem, 6.5vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 42rem;
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 0.74);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.75;
  }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }

  .actions a {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .primary {
    color: #fff;
    background: var(--color-accent);
    padding: 0.95rem 1.75rem 0.95rem 1.35rem;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.85rem) 100%, 0 100%);
  }
  .primary:hover, .primary:focus-visible { background: #fff; color: var(--color-dark); }
  .secondary { color: #fff; }
  .secondary span { color: #9fd1cf; margin-left: 0.35rem; }
  .secondary:hover, .secondary:focus-visible { color: #9fd1cf; }

  .focus {
    list-style: none;
    margin: 2rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.4rem;
    color: rgb(255 255 255 / 0.58);
    font-family: var(--font-ui);
    font-size: 0.76rem;
  }

  .focus li::before {
    content: '';
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    margin-right: 0.55rem;
    transform: rotate(45deg);
    background: var(--color-accent);
    vertical-align: 0.08rem;
  }

  .focus li:last-child::before { background: var(--color-accent-warm); }
  .portrait { position: relative; margin: 0; width: min(100%, 29rem); justify-self: end; }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    clip-path: polygon(9% 0, 100% 0, 100% 90%, 88% 100%, 0 100%, 0 10%);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.4);
  }

  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }

  figcaption {
    position: absolute;
    right: -1rem;
    bottom: 2rem;
    width: min(18rem, 86%);
    padding: 1rem 1.9rem 1rem 1.15rem;
    border-left: 0.3rem solid var(--color-accent-warm);
    background: rgb(251 250 247 / 0.96);
    color: var(--color-ink);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.28);
    clip-path: polygon(0 0, 100% 0, calc(100% - 1.1rem) 100%, 0 100%);
  }

  figcaption span, figcaption strong, figcaption small { display: block; }
  figcaption span { color: var(--color-accent); font-family: var(--font-display); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  figcaption strong { margin-top: 0.2rem; font-family: var(--font-display); font-size: 1.1rem; }
  figcaption small { margin-top: 0.1rem; color: var(--color-muted); font-size: 0.72rem; }

  .scroll {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    color: rgb(255 255 255 / 0.62);
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .scroll:hover, .scroll:focus-visible { color: #fff; }
  .scroll [data-icon] { color: #9fd1cf; }

  @media (max-width: 56rem) {
    .hero { padding-top: 3rem; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.75rem), 32% 100%, 0 calc(100% - 0.35rem)); }
    .inner { grid-template-columns: 1fr; }
    .copy { max-width: none; }
    .portrait { width: min(82vw, 31rem); justify-self: center; }
  }

  @media (max-width: 34rem) {
    h1 { font-size: clamp(2.6rem, 14vw, 4.2rem); }
    .portrait { width: 100%; }
    figcaption { right: 0.75rem; bottom: 0.75rem; }
    .scroll { display: none; }
  }
</style>
