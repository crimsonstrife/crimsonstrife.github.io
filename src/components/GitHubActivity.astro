---
import { Icon } from 'astro-icon/components';
import { fetchActivity, fetchContributions } from '../lib/github';

const [activity, contributions] = await Promise.all([fetchActivity(6), fetchContributions()]);
const { repos, languages } = activity;

const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;

const weeks = contributions?.weeks ?? [];
const width = weeks.length * STEP;
const height = 7 * STEP;

// Month labels sit above the first week that starts a new month.
const months: { label: string; x: number }[] = [];
let lastMonth = -1;
weeks.forEach((week, index) => {
  const first = week[0];
  if (!first) return;
  const month = new Date(`${first.date}T00:00:00Z`).getUTCMonth();
  if (month !== lastMonth) {
    lastMonth = month;
    months.push({
      label: new Date(`${first.date}T00:00:00Z`).toLocaleDateString('en-US', {
        month: 'short',
        timeZone: 'UTC',
      }),
      x: index * STEP,
    });
  }
});

const dayFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

{(repos.length > 0 || contributions) && (
  <section class="activity" aria-labelledby="github-title">
    <div class="activity-inner">
      <header class="activity-head">
        <div>
          <p class="eyebrow">What is public</p>
          <h3 id="github-title">Recent GitHub activity</h3>
          <p class="intro">Public repositories and experiments. Some of these are finished; most of them are not.</p>
        </div>
        <a class="profile" href="https://github.com/crimsonstrife" rel="noopener">
          View GitHub profile
          <Icon name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" />
        </a>
      </header>

      {(languages.length > 0 || contributions) && (
        <div class="overview">
          {languages.length > 0 && (
            <div class="languages">
              <span class="overview-icon"><Icon name="fa6-solid:code" aria-hidden="true" /></span>
              <p class="label">Most-used languages</p>
              <p class="language-list">{languages.map((language) => <span>{language}</span>)}</p>
            </div>
          )}

          {contributions && (
            <figure class="calendar">
              <figcaption>
                <span>Last 12 months</span>
                <strong>{contributions.total.toLocaleString()} contributions</strong>
              </figcaption>

              <div class="scroll">
                <svg
                  viewBox={`0 -14 ${width} ${height + 14}`}
                  width={width}
                  height={height + 14}
                  role="img"
                  aria-label={`GitHub contribution calendar: ${contributions.total} contributions between ${contributions.from} and ${contributions.to}`}
                >
                  {months.map((month) => (
                    <text class="month" x={month.x} y={-4}>{month.label}</text>
                  ))}
                  {weeks.map((week, weekIndex) =>
                    week.map((day) => (
                      <rect
                        class={`day level-${day.level}`}
                        x={weekIndex * STEP}
                        y={new Date(`${day.date}T00:00:00Z`).getUTCDay() * STEP}
                        width={CELL}
                        height={CELL}
                      >
                        <title>
                          {day.count === 0
                            ? `No contributions on ${dayFormatter.format(new Date(`${day.date}T00:00:00Z`))}`
                            : `${day.count} contribution${day.count === 1 ? '' : 's'} on ${dayFormatter.format(new Date(`${day.date}T00:00:00Z`))}`}
                        </title>
                      </rect>
                    ))
                  )}
                </svg>
              </div>

              <p class="legend">
                <span>Less</span>
                {[0, 1, 2, 3, 4].map((level) => <i class={`swatch level-${level}`} aria-hidden="true" />)}
                <span>More</span>
              </p>
            </figure>
          )}
        </div>
      )}

      {repos.length > 0 && (
        <div class="repository-block">
          <h4>Recently updated repositories</h4>
          <ul class="repos" role="list">
            {repos.map((repo) => (
              <li>
                <a href={repo.url} rel="noopener">
                  <span class="repo-head">
                    <span class="name">
                      <Icon name="fa6-brands:github" aria-hidden="true" />
                      {repo.name}
                    </span>
                    <Icon class="arrow" name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" />
                  </span>
                  {repo.description && <span class="desc">{repo.description}</span>}
                  <span class="meta">
                    {repo.language && <span class="lang">{repo.language}</span>}
                    {repo.stars > 0 && (
                      <span class="stars">
                        <Icon name="fa6-solid:star" aria-hidden="true" /> {repo.stars}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .activity {
    padding: calc(var(--section-padding-y) + 1.5rem) 0 calc(var(--section-padding-y) + 1.5rem);
    background: var(--color-dark);
    color: #fff;
    overflow: hidden;
    clip-path: polygon(0 1.5rem, 42% 0, 100% 1rem, 100% calc(100% - 1.5rem), 62% 100%, 0 calc(100% - 0.5rem));
  }

  .activity-inner {
    width: 100%;
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: var(--content-gutter);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .activity-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .activity-head > div { max-width: 38rem; }

  .eyebrow {
    color: #9fd1cf;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.55rem;
  }

  h3 {
    font-size: clamp(2rem, 4vw, 3.15rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro {
    max-width: 38rem;
    color: rgb(255 255 255 / 0.68);
    margin-top: 0.85rem;
  }

  .profile {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.3);
    padding: 0.75rem 1rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.65rem) 100%, 0 100%);
    transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .profile:hover, .profile:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .overview {
    display: grid;
    grid-template-columns: minmax(11.5rem, 0.34fr) minmax(0, 1.66fr);
    gap: 1rem;
    align-items: start;
  }

  .overview > * {
    min-width: 0;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 0.055);
  }

  .overview > :only-child { grid-column: 1 / -1; }

  .languages {
    display: grid;
    align-content: center;
    align-self: start;
    gap: 0.5rem;
    padding: 1.35rem;
  }

  .overview-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.65rem;
    background: var(--color-accent);
    color: #fff;
    margin-bottom: 0.35rem;
  }

  .languages .label,
  .calendar figcaption span,
  .repository-block h4 {
    color: rgb(255 255 255 / 0.55);
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .language-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .language-list span {
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    padding: 0.3rem 0.55rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
  }

  /* --- Calendar --------------------------------------------------- */

  .calendar {
    margin: 0;
    padding: 1.35rem;
  }

  .calendar figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .calendar figcaption strong {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .calendar svg {
    display: block;
    width: 100%;
    height: auto;
    min-width: 42rem;
  }

  .month {
    font-family: var(--font-ui);
    font-size: 9px;
    fill: rgb(255 255 255 / 0.55);
  }

  /* GitHub's green translated into the Barnhardt teal ramp. */
  .day, .swatch { rx: 2px; }
  .level-0 { fill: #4a4748; }
  .level-1 { fill: #78aaa7; }
  .level-2 { fill: #3d8d89; }
  .level-3 { fill: #0f716e; }
  .level-4 { fill: #00a09a; }

  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    margin-top: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.55);
  }

  .legend span:first-child { margin-right: 0.2rem; }
  .legend span:last-child { margin-left: 0.2rem; }

  .swatch {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  .swatch.level-0 { background: #4a4748; }
  .swatch.level-1 { background: #78aaa7; }
  .swatch.level-2 { background: #3d8d89; }
  .swatch.level-3 { background: #0f716e; }
  .swatch.level-4 { background: #00a09a; }

  /* --- Repositories ----------------------------------------------- */

  .repository-block { display: grid; gap: 0.85rem; }

  .repos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .repos a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.055);
    padding: 1.1rem;
    text-decoration: none;
    color: #fff;
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .repos a:hover, .repos a:focus-visible {
    transform: translateY(-2px);
    border-color: rgb(159 209 207 / 0.65);
    background: rgb(255 255 255 / 0.09);
  }

  .repo-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: #9fd1cf;
    word-break: break-word;
  }

  .arrow { color: rgb(255 255 255 / 0.4); flex: none; margin-top: 0.2rem; }

  .desc { font-size: 0.85rem; line-height: 1.5; color: rgb(255 255 255 / 0.62); flex: 1; }

  .meta {
    display: flex;
    gap: 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.52);
  }

  .stars { display: inline-flex; align-items: center; gap: 0.25rem; }

  @media (max-width: 62rem) {
    .repos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 46rem) {
    .activity-head { align-items: flex-start; flex-direction: column; }
    .overview { grid-template-columns: 1fr; }
    .calendar figcaption { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
  }

  @media (max-width: 34rem) {
    .repos { grid-template-columns: 1fr; }
    .profile { width: 100%; justify-content: center; }
  }
</style>
