---
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import GitHubActivity from './GitHubActivity.astro';
import { hasWriteup } from '../lib/content';

// The featured project receives a full case-study treatment immediately above
// this archive, so it does not need a duplicate tile here.
const projects = (await getCollection('projects'))
  .filter((project) => !project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const allCategories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);

// Only offer filters that actually have work behind them.
const used = new Set(projects.map((p) => p.data.category));
const categories = allCategories.filter((c) => used.has(c.data.id));
const ARCHIVE_BATCH_SIZE = 8;

/**
 * Pre-resolve each tile's lightbox payload at build time so the dialog only
 * has to read data attributes — no client-side asset resolution.
 */
const tiles = await Promise.all(
  projects.map(async (project) => {
    const { media } = project.data;
    // Projects with a write-up navigate to their page; the rest open the lightbox.
    const href = hasWriteup(project.body) ? `/projects/${project.id}/` : undefined;
    // Nothing to show and nothing to open: the tile is inert rather than a
    // button that does nothing when clicked.
    if (!media) return { project, href, kind: 'none' as const, src: undefined };
    if (media.type === 'image') {
      const full = await getImage({ src: media.full ?? media.thumbnail, width: 1400 });
      return { project, href, kind: 'image' as const, src: full.src, thumb: media.thumbnail };
    }
    if (media.type === 'youtube') {
      return {
        project,
        href,
        kind: 'youtube' as const,
        src: `https://www.youtube-nocookie.com/embed/${media.videoId}?autoplay=1`,
        poster: `https://i.ytimg.com/vi/${media.videoId}/hqdefault.jpg`,
      };
    }
    return {
      project,
      href,
      kind: 'sketchfab' as const,
      src: `https://sketchfab.com/models/${media.modelId}/embed?autostart=1`,
      // Optional still for the tile; the viewer itself still loads on click.
      posterImage: media.poster,
    };
  })
);
---

<section id="work" class="work">
  <span id="showbox-helicalgamesnet" class="legacy-anchor" aria-hidden="true"></span>
  <SectionHeader eyebrow="The broader body of work" title="Project archive" />

  <div class="filters">
    <ul role="list">
      <li>
        <button type="button" class="chip" data-filter="all" aria-pressed="true">Show all</button>
      </li>
      {categories.map((category) => (
        <li>
          <button type="button" class="chip" data-filter={category.data.id} aria-pressed="false">
            {category.data.label}
          </button>
        </li>
      ))}
    </ul>
  </div>

  <ul id="project-grid" class="grid" role="list">
    {tiles.map(({ project, href, kind, src, poster, posterImage, thumb }, index) => {
      // An anchor when there's a page to go to, a button when there's something
      // to open in the lightbox, and inert when there is neither.
      const Tag = href ? 'a' : kind === 'none' ? 'div' : 'button';
      const interactive = Boolean(href) || kind !== 'none';
      return (
      <li class="cell" data-category={project.data.category} hidden={index >= ARCHIVE_BATCH_SIZE}>
        <Tag
          class:list={['tile', { inert: !interactive }]}
          href={href}
          type={Tag === 'button' ? 'button' : undefined}
          data-lightbox-trigger={href || !interactive ? undefined : true}
          data-kind={href || !interactive ? undefined : kind}
          data-src={href ? undefined : src}
          data-title={project.data.title}
        >
          {kind === 'image' && (
            <Image
              class="art"
              src={thumb}
              alt=""
              widths={[300, 600]}
              sizes="(min-width: 62rem) 25vw, (min-width: 40rem) 50vw, 100vw"
              loading="lazy"
            />
          )}

          {kind === 'youtube' && (
            <img class="art" src={poster} alt="" loading="lazy" decoding="async" width="480" height="360" />
          )}

          {kind === 'none' && (
            <span class="art placeholder">
              <Icon name="fa6-solid:code" aria-hidden="true" />
              <span class="placeholder-title">{project.data.title}</span>
            </span>
          )}

          {kind === 'sketchfab' &&
            (posterImage ? (
              <Image
                class="art"
                src={posterImage}
                alt=""
                widths={[300, 600]}
                sizes="(min-width: 62rem) 25vw, (min-width: 40rem) 50vw, 100vw"
                loading="lazy"
              />
            ) : (
              <span class="art placeholder">
                <Icon name="fa6-solid:cube" aria-hidden="true" />
                <span class="placeholder-title">{project.data.title}</span>
              </span>
            ))}

          <span class="overlay">
            <span class="title">{project.data.title}</span>
            {project.data.summary && <span class="summary">{project.data.summary}</span>}
            <span class="cue">
              {href
                ? 'Read more'
                : kind === 'youtube'
                  ? 'Play video'
                  : kind === 'sketchfab'
                    ? 'View in 3D'
                    : kind === 'none'
                      ? 'In development'
                      : 'View image'}
            </span>
          </span>
        </Tag>
      </li>
      );
    })}
  </ul>

  <p class="empty" hidden>Nothing in that category yet.</p>

  <div class="archive-controls" data-batch-size={ARCHIVE_BATCH_SIZE}>
    <p class="archive-count" aria-live="polite">
      Showing {Math.min(ARCHIVE_BATCH_SIZE, tiles.length)} of {tiles.length} projects
    </p>
    <button
      type="button"
      class="load-more"
      aria-controls="project-grid"
      hidden={tiles.length <= ARCHIVE_BATCH_SIZE}
    >
      Show {Math.min(ARCHIVE_BATCH_SIZE, Math.max(0, tiles.length - ARCHIVE_BATCH_SIZE))} more projects
    </button>
  </div>

  <div class="github">
    <GitHubActivity />
  </div>
</section>

<style>
  .work {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  /* --- Filter bar ------------------------------------------------- */

  .filters ul {
    list-style: none;
    margin: 0 0 clamp(1.75rem, 4vw, 3.125rem);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.15rem 0.35rem;
  }

  .chip {
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0.85rem 1.1rem;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .chip:hover { color: var(--color-ink); }

  .chip[aria-pressed='true'] {
    color: var(--color-crimson);
    border-bottom-color: var(--color-crimson);
  }

  /* --- Grid ------------------------------------------------------- */

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.2vw, 0.9rem);
  }

  @media (max-width: 62rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .grid { grid-template-columns: minmax(0, 1fr); } }

  .cell[hidden] { display: none; }

  .tile {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: var(--color-surface-sunk);
    cursor: pointer;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.9rem), calc(100% - 0.9rem) 100%, 0 100%);
  }

  /* Nothing to open and nowhere to go — don't promise a click. */
  .tile.inert {
    cursor: default;
  }

  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.7rem;
    padding: 1rem;
    background: var(--color-tile-empty);
    color: var(--color-crimson);
    font-size: 2.1rem;
    text-align: center;
  }

  .placeholder-title {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.25rem;
    background: rgb(0 101 101 / 0.92);
    color: #fff;
    text-align: center;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .tile:hover .overlay,
  .tile:focus-visible .overlay { opacity: 1; }

  .title {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.6vw, 1.4rem);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .summary {
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cue {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-top: 1px solid rgb(255 255 255 / 0.5);
    padding-top: 0.5rem;
    margin-top: 0.15rem;
  }

  .empty {
    text-align: center;
    color: var(--color-muted);
    padding: 3rem 0;
  }

  .archive-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .archive-count {
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  .load-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-accent);
    background: transparent;
    color: var(--color-accent-dark);
    cursor: pointer;
    padding: 0.75rem 1.05rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.7rem) 100%, 0 100%);
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .load-more:hover,
  .load-more:focus-visible {
    background: var(--color-accent);
    color: #fff;
  }

  .load-more[hidden] { display: none; }

  @media (max-width: 34rem) {
    .archive-controls {
      align-items: stretch;
      flex-direction: column;
    }

    .archive-count { text-align: center; }
  }

  .github {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-top: 0;
  }

  /* Anchors from the 2017 site, kept so old links and bookmarks still land. */
  .legacy-anchor {
    display: block;
    height: 0;
    scroll-margin-top: var(--header-height);
  }
</style>

<script>
  // --- Filtering ---------------------------------------------------
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cells = [...document.querySelectorAll<HTMLLIElement>('.cell')];
  const empty = document.querySelector<HTMLParagraphElement>('.empty');
  const archiveControls = document.querySelector<HTMLDivElement>('.archive-controls');
  const archiveCount = document.querySelector<HTMLParagraphElement>('.archive-count');
  const loadMore = document.querySelector<HTMLButtonElement>('.load-more');
  const batchSize = Number(archiveControls?.dataset.batchSize ?? 8);
  let activeFilter = 'all';
  let visibleLimit = batchSize;

  function renderArchive() {
    const matching = cells.filter(
      (cell) => activeFilter === 'all' || cell.dataset.category === activeFilter
    );

    cells.forEach((cell) => { cell.hidden = true; });
    matching.slice(0, visibleLimit).forEach((cell) => { cell.hidden = false; });

    const visible = Math.min(visibleLimit, matching.length);
    const remaining = Math.max(0, matching.length - visible);
    if (empty) empty.hidden = matching.length > 0;
    if (archiveCount) {
      archiveCount.textContent = matching.length > 0
        ? `Showing ${visible} of ${matching.length} projects`
        : 'No projects in this category';
    }
    if (loadMore) {
      loadMore.hidden = remaining === 0;
      const nextBatch = Math.min(batchSize, remaining);
      loadMore.textContent = `Show ${nextBatch} more project${nextBatch === 1 ? '' : 's'}`;
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter ?? 'all';
      visibleLimit = batchSize;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      renderArchive();
    });
  });

  loadMore?.addEventListener('click', () => {
    visibleLimit += batchSize;
    renderArchive();
  });

  renderArchive();

</script>
