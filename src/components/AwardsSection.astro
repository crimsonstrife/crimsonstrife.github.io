---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import { formatMonth } from '../lib/dates';

const awards = (await getCollection('awards')).sort((a, b) => a.data.order - b.data.order);
---

<section id="awards" class="awards">
  <SectionHeader eyebrow="From the communities I am in" title="Honors & Awards" />

  <ul class="list" role="list">
    {awards.map((entry) => (
      <li>
        <div class="badge-well">
          {entry.data.badge ? (
            <Image class="badge" src={entry.data.badge} alt="" width={136} loading="lazy" />
          ) : (
            <Icon class="mark" name="fa6-solid:award" aria-hidden="true" />
          )}
        </div>
        <div class="copy">
          <h3>{entry.data.title}</h3>
          <p class="meta">
            {entry.data.issuer}
            {entry.data.issued && <span aria-hidden="true"> · </span>}
            {entry.data.issued && formatMonth(entry.data.issued)}
          </p>
          {entry.data.credentialUrl && (
            <a href={entry.data.credentialUrl} rel="noopener">View badge</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .awards {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 6vw, 5rem);
    border-top: 1px solid var(--color-rule);
  }

  .awards .list > li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 10.5rem;
    border-bottom: 1px solid var(--color-rule);
    padding: 1.5rem 1rem 1.5rem 0;
  }

  .awards .list > li::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    width: 2.5rem;
    height: 0.24rem;
    background: var(--color-accent-warm);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }

  .badge-well {
    width: 7.5rem;
    height: 7.5rem;
    flex: none;
    display: grid;
    place-items: center;
    background: transparent;
    clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
  }

  .badge { width: 7rem; height: 7rem; object-fit: contain; }

  .mark { font-size: 2rem; color: var(--color-accent); }

  .awards .list h3 { font-size: 1rem; line-height: 1.35; text-transform: none; }

  .meta {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  a {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-crimson);
    text-decoration: none;
  }

  a:hover, a:focus-visible { text-decoration: underline; }

  @media (max-width: 30rem) {
    .awards .list > li { align-items: flex-start; min-height: 0; }
    .badge-well { width: 5.5rem; height: 5.5rem; }
    .badge { width: 5.1rem; height: 5.1rem; }
  }

  @media (max-width: 48rem) {
    .list { grid-template-columns: 1fr; }
  }
</style>
