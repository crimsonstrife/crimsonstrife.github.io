---
import { Icon } from 'astro-icon/components';
---

<section id="capabilities" class="tracks" aria-labelledby="capabilities-title">
  <header class="intro">
    <p>One developer, two arenas</p>
    <h2 id="capabilities-title">Software systems and interactive worlds</h2>
    <span>
      The same curiosity, systems thinking, and care for the person using the
      result runs through both sides of my work.
    </span>
  </header>

  <div class="grid">
    <article class="track software">
      <Icon name="fa6-solid:code" aria-hidden="true" />
      <p class="number">Professional track</p>
      <h3>Software &amp; business systems</h3>
      <p>
        Reliable software, Salesforce solutions, web platforms, automation,
        and support for the people and processes behind them.
      </p>
      <ul role="list">
        <li>Salesforce &amp; Apex</li>
        <li>Web platforms</li>
        <li>Internal tools</li>
      </ul>
      <a href="#resume">See professional experience <span aria-hidden="true">→</span></a>
    </article>

    <article class="track games">
      <Icon name="fa6-solid:gamepad" aria-hidden="true" />
      <p class="number">Independent track</p>
      <h3>Games &amp; interactive systems</h3>
      <p>
        Original game development, Unreal Engine tooling, C++ and Blueprint
        gameplay systems, integration work, and technical art.
      </p>
      <ul role="list">
        <li>Unreal Engine</li>
        <li>Gameplay systems</li>
        <li>Tools &amp; plugins</li>
      </ul>
      <a href="#selected-work">Explore One Man's Poison <span aria-hidden="true">→</span></a>
    </article>
  </div>
</section>

<style>
  .tracks {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--section-padding-y) clamp(1rem, 4vw, 2.25rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    gap: 0.7rem clamp(2rem, 7vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .intro > p {
    grid-row: 1;
    grid-column: 1;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .intro h2 {
    grid-row: 2;
    grid-column: 1 / -1;
    max-width: 20ch;
    font-size: var(--size-section-header);
    line-height: 1.02;
  }

  .intro > span {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: end;
    max-width: 34rem;
    justify-self: end;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }

  .track {
    position: relative;
    overflow: hidden;
    min-height: 26rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-rule);
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: 0 1.25rem 3rem rgb(38 35 36 / 0.06);
  }

  .track::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.35rem;
    background: var(--track-color);
  }

  .track > [data-icon] {
    width: 3rem;
    height: 3rem;
    padding: 0.75rem;
    border-radius: 0.85rem;
    color: #fff;
    background: var(--track-color);
    margin-bottom: 2rem;
  }

  .software { --track-color: var(--color-accent); }
  .games { --track-color: var(--color-accent-warm); }

  .number {
    color: var(--track-color);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h3 {
    margin-top: 0.6rem;
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.1;
  }

  .track > p:not(.number) {
    margin-top: 1rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  ul {
    list-style: none;
    margin: 1.5rem 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  li {
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.76rem;
  }

  a {
    margin-top: auto;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  a span { color: var(--track-color); margin-left: 0.35rem; }
  a:hover, a:focus-visible { color: var(--track-color); }

  @media (max-width: 48rem) {
    .intro { grid-template-columns: 1fr; }
    .intro > p, .intro h2, .intro > span { grid-column: 1; grid-row: auto; justify-self: start; }
    .intro > span { margin-top: 0.75rem; }
    .grid { grid-template-columns: 1fr; }
    .track { min-height: 0; }
  }
</style>
