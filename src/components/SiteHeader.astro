---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import wordmark from '../assets/brand/barnhardt-wordmark.svg';
import monogram from '../assets/brand/barnhardt-monogram.svg';

const path = Astro.url.pathname;
---

<header class="bar">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <Image class="wordmark" src={wordmark} alt={site.name} width={190} />
    <Image class="monogram" src={monogram} alt="" width={42} height={42} />
  </a>

  <button class="toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
    <span class="bars" aria-hidden="true"></span>
  </button>

  <nav id="primary-nav" class="nav" aria-label="Primary">
    <ul>
      {site.nav.map((item) => (
        <li>
          <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    min-height: var(--header-height);
    background: rgb(251 250 247 / 0.96);
    color: var(--color-ink);
    border-bottom: 1px solid rgb(38 35 36 / 0.1);
    backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: clamp(1rem, 4vw, 2.25rem);
  }

  .brand { display: flex; align-items: center; color: inherit; text-decoration: none; margin-right: auto; }

  .wordmark {
    display: block;
    width: 10.8rem;
    height: 3.5rem;
    object-fit: contain;
    object-position: left center;
  }

  .monogram { display: none; }

  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: clamp(0.5rem, 2vw, 1.5rem); }

  .nav a {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.5rem 0.2rem;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .nav a:hover, .nav a:focus-visible, .nav a[aria-current='page'] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .toggle { display: none; background: none; border: 0; color: inherit; padding: 0.6rem; cursor: pointer; }

  .bars, .bars::before, .bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  .bars::before, .bars::after { content: ''; position: relative; }
  .bars::before { top: -6px; }
  .bars::after { top: 4px; }
  .toggle[aria-expanded='true'] .bars { background: transparent; }
  .toggle[aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
  .toggle[aria-expanded='true'] .bars::after { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 46rem) {
    .wordmark { display: none; }
    .monogram { display: block; width: 2.625rem; height: 2.625rem; }
    .toggle { display: block; }

    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-rule);
      box-shadow: 0 1rem 2rem rgb(38 35 36 / 0.08);
      display: none;
    }

    .nav[data-open] { display: block; }
    .nav ul { flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem 0 1rem; }
    .nav a { padding: 0.8rem clamp(1rem, 4vw, 2.25rem); border: 0; border-left: 3px solid transparent; }

    .nav a:hover, .nav a:focus-visible, .nav a[aria-current='page'] {
      border-left-color: var(--color-accent);
      background: var(--color-accent-tint);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      nav.toggleAttribute('data-open', !open);
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        nav.removeAttribute('data-open');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.hasAttribute('data-open')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        nav.removeAttribute('data-open');
        toggle.focus();
      }
    });
  }
</script>
