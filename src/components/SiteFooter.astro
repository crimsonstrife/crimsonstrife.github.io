---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const social = (await getCollection('social')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const copyrightYears = site.copyrightStartYear === year
  ? `${year}`
  : `${site.copyrightStartYear}\u2013${year}`;
---

<footer class="footer">
  <div class="inner">
    <a class="item" href={`mailto:${site.email}`}>
      <Icon name="fa6-solid:envelope" class="icon" />
      <span>
        <span class="label">Email</span>
        <span class="value">{site.email}</span>
      </span>
    </a>

    <ul class="social" aria-label="Elsewhere">
      {social.map((entry) => (
        <li>
          <a href={entry.data.url} aria-label={entry.data.label} rel="me noopener">
            {entry.data.icon.startsWith('/') ? (
              <span
                class="custom-brand-icon"
                aria-hidden="true"
                style={`--brand-icon-image: url('${entry.data.icon}')`}
              ></span>
            ) : (
              <Icon name={entry.data.icon} />
            )}
          </a>
        </li>
      ))}
    </ul>

    <a class="top" href="#top">
      <Icon name="fa6-solid:arrow-up" />
      <span>Back to top</span>
    </a>
  </div>

  <div class="fine">
    <p>&copy; {copyrightYears} {site.name}</p>
    <nav aria-label="Legal">
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true">&middot;</span>
      <a href="/legal/">Legal &amp; attributions</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: #fff;
    padding: 2.5rem clamp(1rem, 4vw, 2.25rem) 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--container-max);
    width: 100%;
    margin-inline: auto;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #fff;
    text-decoration: none;
  }

  .item .icon { font-size: 1.5rem; color: var(--color-crimson); }

  .item span span { display: block; }

  .label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-rule);
  }

  .value { font-size: var(--size-small); }

  .item:hover .value,
  .item:focus-visible .value { text-decoration: underline; }

  .social {
    list-style: none;
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    font-size: 1.15rem;
  }

  .social a {
    color: var(--color-rule);
    transition: color var(--dur-fast) var(--ease);
    display: block;
  }

  .social .custom-brand-icon {
    display: block;
    width: 0.85em;
    height: 1.12em;
    background: currentColor;
    -webkit-mask: var(--brand-icon-image) center / contain no-repeat;
    mask: var(--brand-icon-image) center / contain no-repeat;
  }

  .social a:hover,
  .social a:focus-visible { color: #fff; }

  .top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
  }

  .top:hover, .top:focus-visible { color: var(--color-rule); }

  .fine {
    max-width: var(--container-max);
    width: 100%;
    margin-inline: auto;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.75rem;
    color: var(--color-rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .fine nav { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .fine a { color: inherit; text-underline-offset: 0.2em; }

  .fine a:hover,
  .fine a:focus-visible { color: #fff; }

  .footer :global(a):focus-visible { outline-color: #fff; }
</style>
