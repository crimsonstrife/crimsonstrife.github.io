---
interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
}
const { title, id, eyebrow } = Astro.props;
---

<div class="section-header" id={id}>
  {eyebrow && <p>{eyebrow}</p>}
  <h2>{title}</h2>
</div>

<style>
  .section-header {
    padding-block: clamp(4rem, 9vw, 7.5rem) clamp(2rem, 4vw, 3.5rem);
    display: grid;
    gap: 0.65rem;
    justify-items: start;
    text-align: left;
    position: relative;
  }

  .section-header::after {
    content: '';
    width: clamp(4.5rem, 9vw, 8rem);
    height: 0.3rem;
    margin-top: 0.45rem;
    background: linear-gradient(90deg, var(--color-accent) 0 72%, var(--color-accent-warm) 72%);
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 100%, 0 100%);
  }

  .section-header h2 {
    font-size: var(--size-section-header);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0;
    text-align: left;
    text-transform: none;
  }

  .section-header p {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
