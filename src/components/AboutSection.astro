---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import monogram from '../assets/brand/barnhardt-monogram.svg';

const social = (await getCollection('social')).sort((a, b) => a.data.order - b.data.order);
const featuredIds = new Set(['github', 'linkedin', 'youtube', 'twitch', 'experts-exchange']);
const featuredSocial = social.filter((entry) => featuredIds.has(entry.data.id));
const elsewhere = social.filter((entry) => !featuredIds.has(entry.data.id));
const [about] = await getCollection('pages', (entry) => entry.id === 'about');
const { Content } = about ? await render(about) : { Content: null };
---

<section id="about" class="about">
  <span id="about-section" class="legacy-anchor" aria-hidden="true"></span>
  <div class="inner">
    <SectionHeader eyebrow="The short version" title="About Patrick" />

    <div class="layout">
      {Content && (
        <div class="prose">
          <Content />
        </div>
      )}

      <aside class="connect" aria-labelledby="connect-title">
        <div class="connect-head">
          <Image src={monogram} alt="" width={72} height={72} />
          <div>
            <p>Follow the work</p>
            <h3 id="connect-title">Code, devlogs, and professional updates</h3>
          </div>
        </div>

        <ul class="featured" role="list">
          {featuredSocial.map((entry) => (
            <li>
              <a href={entry.data.url} rel="me noopener" style={`--brand-color: ${entry.data.color}`}>
                <span class="brand-icon-mark" aria-hidden="true">
                  {entry.data.icon.startsWith('/') ? (
                    <span
                      class="custom-brand-icon"
                      style={`--brand-icon-image: url('${entry.data.icon}')`}
                    ></span>
                  ) : (
                    <Icon name={entry.data.icon} />
                  )}
                </span>
                <span>
                  <strong>{entry.data.label}</strong>
                  <small>{entry.data.description}</small>
                </span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="elsewhere">
          <span>Elsewhere</span>
          <ul role="list">
            {elsewhere.map((entry) => (
              <li>
                <a
                  href={entry.data.url}
                  aria-label={entry.data.label}
                  title={entry.data.label}
                  rel="me noopener"
                  style={`--brand-color: ${entry.data.color}`}
                >
                  <span class="brand-icon-mark" aria-hidden="true">
                    {entry.data.icon.startsWith('/') ? (
                      <span
                        class="custom-brand-icon"
                        style={`--brand-icon-image: url('${entry.data.icon}')`}
                      ></span>
                    ) : (
                      <Icon name={entry.data.icon} />
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: 0 0 calc(var(--section-padding-y) + var(--section-slant));
    background:
      linear-gradient(105deg, rgb(0 101 101 / 0.07), transparent 44%),
      var(--color-surface-sunk);
    clip-path: polygon(0 var(--section-slant), 24% 0, 100% clamp(1.5rem, 3.5vw, 3.5rem), 100% calc(100% - var(--section-slant)), 78% 100%, 0 calc(100% - clamp(0.8rem, 1.75vw, 1.75rem)));
  }

  .inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--content-gutter);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(28rem, 1.2fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .prose { color: var(--color-muted); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.8; }
  .prose :global(p:first-child) { color: var(--color-ink); font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.55; }
  .prose :global(p + p) { margin-top: 1.25rem; }

  .connect {
    position: relative;
    padding: clamp(1.25rem, 4vw, 2rem) 0 clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 4vw, 3.25rem);
    border-left: 0.35rem solid var(--color-accent);
  }

  .connect::after {
    content: '';
    position: absolute;
    left: -0.35rem;
    bottom: 0;
    width: 0.35rem;
    height: 23%;
    background: var(--color-accent-warm);
  }

  .connect-head { display: flex; align-items: center; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-rule); }
  .connect-head img { flex: none; clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%); }
  .connect-head p { color: var(--color-accent); font-family: var(--font-display); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .connect-head h3 { margin-top: 0.25rem; font-size: clamp(1rem, 2vw, 1.25rem); }

  .featured { list-style: none; margin: 0; padding: 0; }
  .featured li + li { border-top: 1px solid var(--color-rule); }

  .featured a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 1.1rem 0.25rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-icon-mark {
    display: grid;
    place-items: center;
    color: var(--brand-color);
    transition: filter var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .featured .brand-icon-mark {
    width: 1.8rem;
    height: 1.8rem;
  }

  .featured .brand-icon-mark [data-icon] { font-size: 1.25rem; }
  .featured .custom-brand-icon {
    width: 0.8rem;
    height: 1.05rem;
  }
  .featured strong, .featured small { display: block; }
  .featured strong { font-family: var(--font-display); font-size: 0.85rem; }
  .featured small { margin-top: 0.2rem; color: var(--color-muted); font-size: 0.72rem; line-height: 1.4; }
  .featured .arrow { color: var(--color-accent-warm); }
  .featured a:hover strong, .featured a:focus-visible strong { color: var(--color-accent); }
  .featured a:hover .brand-icon-mark,
  .featured a:focus-visible .brand-icon-mark {
    filter: brightness(0.82) saturate(1.12);
    transform: translateY(-1px);
  }

  .elsewhere { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--color-rule); }
  .elsewhere > span { color: var(--color-muted); font-family: var(--font-display); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .elsewhere ul { list-style: none; display: flex; gap: 0.75rem; margin: 0; padding: 0; }
  .elsewhere a { display: block; color: var(--color-muted); font-size: 1rem; }
  .elsewhere .brand-icon-mark {
    width: 1.65rem;
    height: 1.65rem;
  }
  .elsewhere .brand-icon-mark [data-icon] { font-size: 1rem; }
  .elsewhere .custom-brand-icon {
    width: 0.68rem;
    height: 0.9rem;
  }
  .elsewhere a:hover .brand-icon-mark,
  .elsewhere a:focus-visible .brand-icon-mark {
    filter: brightness(0.82) saturate(1.12);
    transform: translateY(-1px);
  }

  .custom-brand-icon {
    display: block;
    background: currentColor;
    -webkit-mask: var(--brand-icon-image) center / contain no-repeat;
    mask: var(--brand-icon-image) center / contain no-repeat;
  }

  @media (max-width: 56rem) {
    .about { clip-path: polygon(0 2.5rem, 28% 0, 100% 1.5rem, 100% calc(100% - 2rem), 75% 100%, 0 calc(100% - 1rem)); }
    .layout { grid-template-columns: 1fr; }
  }

  @media (max-width: 32rem) {
    .connect { padding: 1rem; }
    .connect-head img { width: 3.5rem; height: 3.5rem; }
    .featured small { display: none; }
  }

  .legacy-anchor { display: block; height: 0; scroll-margin-top: var(--header-height); }
</style>
