---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import logo from '../assets/images/CSlogo2.png';

const social = (await getCollection('social')).sort((a, b) => a.data.order - b.data.order);
const [about] = await getCollection('pages', (entry) => entry.id === 'about');
const { Content } = about ? await render(about) : { Content: null };

const half = Math.ceil(social.length / 2);
const columns = [social.slice(0, half), social.slice(half)];
---

<section id="about" class="about">
  <SectionHeader title="Who Am I?" />

  {Content && (
    <div class="prose">
      <Content />
    </div>
  )}

  <div class="grid">
    <div class="column">
      {columns[0].map((entry) => (
        <a class="box" href={entry.data.url} rel="me noopener">
          <span class="tile" style={`--brand: ${entry.data.color}`}>
            <Icon name={entry.data.icon} aria-hidden="true" />
          </span>
          <span class="text">
            <span class="label">{entry.data.label}</span>
            <span class="desc">{entry.data.description}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="medallion" aria-hidden="true">
      <Image src={logo} alt="" width={260} height={260} />
      <p>Stay in touch</p>
    </div>

    <div class="column right">
      {columns[1].map((entry) => (
        <a class="box" href={entry.data.url} rel="me noopener">
          <span class="tile" style={`--brand: ${entry.data.color}`}>
            <Icon name={entry.data.icon} aria-hidden="true" />
          </span>
          <span class="text">
            <span class="label">{entry.data.label}</span>
            <span class="desc">{entry.data.description}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  .prose {
    max-width: 46rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
    color: var(--color-muted);
  }

  .prose :global(p + p) { margin-top: 1rem; }

  .grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .box {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    text-decoration: none;
    color: inherit;
  }

  .column.right .box { flex-direction: row-reverse; text-align: right; }

  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    border: 5px solid var(--color-surface);
    background: #ebebeb;
    color: #9a938f;
    font-size: 1.9rem;
    box-shadow: 0 0 0 1px var(--color-rule);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .box:hover .tile,
  .box:focus-visible .tile {
    background: var(--brand, var(--color-crimson));
    color: #fff;
  }

  .label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .desc {
    display: block;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
    margin-top: 0.2rem;
  }

  .medallion {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(11rem, 22vw, 16.25rem);
    aspect-ratio: 1;
  }

  .medallion img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .medallion p {
    position: absolute;
    inset: auto 0 auto 0;
    text-align: center;
    background: rgb(24 20 19 / 0.72);
    padding: 0.5rem 0.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.6);
  }

  @media (max-width: 60rem) {
    .grid { grid-template-columns: 1fr; }
    .medallion { order: -1; margin-inline: auto; }
    .column.right .box { flex-direction: row; text-align: left; }
  }
</style>
