---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import monogram from '../assets/brand/barnhardt-monogram.svg';

const social = (await getCollection('social')).sort((a, b) => a.data.order - b.data.order);
const featuredIds = new Set(['github', 'linkedin', 'youtube', 'twitch']);
const featuredSocial = social.filter((entry) => featuredIds.has(entry.data.id));
const elsewhere = social.filter((entry) => !featuredIds.has(entry.data.id));
const [about] = await getCollection('pages', (entry) => entry.id === 'about');
const { Content } = about ? await render(about) : { Content: null };
---

<section id="about" class="about">
  <span id="about-section" class="legacy-anchor" aria-hidden="true"></span>
  <SectionHeader eyebrow="The person behind the work" title="About Patrick" />

  <div class="layout">
    {Content && (
      <div class="prose">
        <Content />
      </div>
    )}

    <aside class="connect" aria-labelledby="connect-title">
      <div class="connect-head">
        <Image src={monogram} alt="" width={72} height={72} />
        <div>
          <p>Follow the work</p>
          <h3 id="connect-title">Code, devlogs, and professional updates</h3>
        </div>
      </div>

      <ul class="featured" role="list">
        {featuredSocial.map((entry) => (
          <li>
            <a href={entry.data.url} rel="me noopener">
              <Icon name={entry.data.icon} aria-hidden="true" />
              <span>
                <strong>{entry.data.label}</strong>
                <small>{entry.data.description}</small>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="elsewhere">
        <span>Elsewhere</span>
        <ul role="list">
          {elsewhere.map((entry) => (
            <li>
              <a href={entry.data.url} aria-label={entry.data.label} title={entry.data.label} rel="me noopener">
                <Icon name={entry.data.icon} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .about {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(28rem, 1.2fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .prose { color: var(--color-muted); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.8; }
  .prose :global(p:first-child) { color: var(--color-ink); font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.55; }
  .prose :global(p + p) { margin-top: 1.25rem; }

  .connect {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-rule);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    box-shadow: 0 1.25rem 3rem rgb(38 35 36 / 0.06);
  }

  .connect-head { display: flex; align-items: center; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-rule); }
  .connect-head img { flex: none; border-radius: 1rem; }
  .connect-head p { color: var(--color-accent); font-family: var(--font-display); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .connect-head h3 { margin-top: 0.25rem; font-size: clamp(1rem, 2vw, 1.25rem); }

  .featured { list-style: none; margin: 0; padding: 0; }
  .featured li + li { border-top: 1px solid var(--color-rule); }

  .featured a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 1.1rem 0.25rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .featured [data-icon] { font-size: 1.25rem; color: var(--color-accent); }
  .featured strong, .featured small { display: block; }
  .featured strong { font-family: var(--font-display); font-size: 0.85rem; }
  .featured small { margin-top: 0.2rem; color: var(--color-muted); font-size: 0.72rem; line-height: 1.4; }
  .featured .arrow { color: var(--color-accent-warm); }
  .featured a:hover strong, .featured a:focus-visible strong { color: var(--color-accent); }

  .elsewhere { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--color-rule); }
  .elsewhere > span { color: var(--color-muted); font-family: var(--font-display); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .elsewhere ul { list-style: none; display: flex; gap: 0.75rem; margin: 0; padding: 0; }
  .elsewhere a { color: var(--color-muted); font-size: 1rem; }
  .elsewhere a:hover, .elsewhere a:focus-visible { color: var(--color-accent); }

  @media (max-width: 56rem) {
    .layout { grid-template-columns: 1fr; }
  }

  @media (max-width: 32rem) {
    .connect { padding: 1rem; }
    .connect-head img { width: 3.5rem; height: 3.5rem; }
    .featured small { display: none; }
  }

  .legacy-anchor { display: block; height: 0; scroll-margin-top: var(--header-height); }
</style>
