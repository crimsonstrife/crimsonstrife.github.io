---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { byRecency, hasWriteup } from '../lib/content';

const featured = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort(byRecency)[0];

const media = featured?.data.media;
const artwork = media?.type === 'image' ? (media.full ?? media.thumbnail) : undefined;
const href = featured && hasWriteup(featured.body) ? `/projects/${featured.id}/` : undefined;

// Only promise a case study when the entry actually is one.
const cta = href
  ? featured?.data.caseStudy
    ? 'Read the case study'
    : 'Read the write-up'
  : 'View project';
const external =
  featured?.data.links.live ??
  featured?.data.links.docs ??
  featured?.data.links.download ??
  featured?.data.links.repo;
const link = href ?? external;
---

{featured && (
  <section id="selected-work" class="featured" aria-labelledby="featured-title">
    <div class="shell">
      <div class="media">
        {artwork ? (
          <Image
            src={artwork}
            alt=""
            widths={[700, 1100, 1500]}
            sizes="(min-width: 54rem) 52vw, 100vw"
            loading="lazy"
          />
        ) : (
          <span class="placeholder"><Icon name="fa6-solid:gamepad" aria-hidden="true" /></span>
        )}
        <p class="track">Games &amp; interactive systems</p>

        {featured.data.imageCredit && (
          <p class="credit">
            {featured.data.imageCredit.role ?? 'Artwork'} by{' '}
            {featured.data.imageCredit.url ? (
              <a href={featured.data.imageCredit.url} rel="noopener">{featured.data.imageCredit.name}</a>
            ) : featured.data.imageCredit.name}
          </p>
        )}
      </div>

      <div class="content">
        <p class="eyebrow">Featured independent game</p>
        <h2 id="featured-title">{featured.data.title}</h2>
        {featured.data.summary && <p class="summary">{featured.data.summary}</p>}

        {featured.data.featureHighlights.length > 0 && (
          <ul class="points" role="list">
            {featured.data.featureHighlights.map((point) => (
              <li>
                <Icon name={point.icon} aria-hidden="true" />
                <div>
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              </li>
            ))}
          </ul>
        )}

        {link && (
          <a class="cta" href={link} rel={href ? undefined : 'noopener'}>
            {cta} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .featured {
    position: relative;
    padding: calc(var(--section-padding-y) + 2rem) var(--content-gutter) calc(var(--section-padding-y) + 2.5rem);
    scroll-margin-top: var(--header-height);
    background: var(--color-dark);
    color: #fff;
    clip-path: polygon(0 var(--section-slant), 64% 0, 100% clamp(1rem, 3vw, 3rem), 100% calc(100% - 2rem), 31% 100%, 0 calc(100% - 1rem));
  }

  .featured::before {
    content: '';
    position: absolute;
    top: var(--section-slant);
    right: 0;
    width: min(32vw, 32rem);
    height: 0.42rem;
    background: var(--color-accent-warm);
    transform: skewY(-5deg);
    transform-origin: right;
  }

  .shell {
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(24rem, 0.92fr);
    min-height: 38rem;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .media {
    position: relative;
    min-height: 32rem;
    height: 100%;
    overflow: hidden;
    background: var(--color-dark-deep);
    clip-path: polygon(0 0, 100% 0, 93% 100%, 0 100%);
  }
  .media > img { position: relative; z-index: 0; width: 100%; height: 100%; object-fit: cover; }
  .media::after { content: ''; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, transparent 58%, rgb(24 22 23 / 0.8)); pointer-events: none; }

  .placeholder { display: grid; place-items: center; width: 100%; height: 100%; color: var(--color-accent); font-size: 4rem; }

  .track {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 2;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border-left: 0.25rem solid var(--color-accent-warm);
    background: rgb(24 22 23 / 0.86);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .credit { position: absolute; z-index: 2; left: 1.5rem; bottom: 1.25rem; margin: 0; color: rgb(255 255 255 / 0.7); font-size: 0.68rem; }
  .credit a { color: inherit; }

  .content { display: flex; flex-direction: column; justify-content: center; padding: clamp(1rem, 3vw, 2.5rem) 0; color: #fff; }

  .eyebrow { color: #9fd1cf; font-family: var(--font-display); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  h2 { margin-top: 0.7rem; font-size: clamp(2.35rem, 5vw, 4.5rem); line-height: 0.98; letter-spacing: -0.04em; }
  .summary { margin-top: 1.25rem; color: rgb(255 255 255 / 0.72); font-size: 1rem; line-height: 1.65; }

  .points { list-style: none; margin: 2rem 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem; }
  .points li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .points [data-icon] { flex: none; margin-top: 0.15rem; color: var(--color-accent-warm); font-size: 1.1rem; }
  .points h3 { font-size: 0.78rem; line-height: 1.3; }
  .points p { margin-top: 0.25rem; color: rgb(255 255 255 / 0.58); font-size: 0.72rem; line-height: 1.5; }

  .cta {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.9rem 1.7rem 0.9rem 1.2rem;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 100%, 0 100%);
  }

  .cta span { margin-left: 0.35rem; color: #b7dcda; }
  .cta:hover, .cta:focus-visible { background: #fff; color: var(--color-dark); }

  @media (max-width: 58rem) {
    .featured { clip-path: polygon(0 2rem, 65% 0, 100% 1rem, 100% calc(100% - 1.25rem), 30% 100%, 0 calc(100% - 0.6rem)); }
    .shell { grid-template-columns: 1fr; min-height: 0; }
    .media { aspect-ratio: 16 / 10; min-height: 0; clip-path: polygon(0 0, 100% 0, 96% 100%, 0 100%); }
  }

  @media (max-width: 34rem) {
    .content { padding: 2rem 1.25rem 2.5rem; }
    .points { grid-template-columns: 1fr; }
  }
</style>
