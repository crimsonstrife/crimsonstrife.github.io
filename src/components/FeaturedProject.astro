---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { hasWriteup } from '../lib/content';

/**
 * The 2017 site had a "showbox": a full-width band with the project's artwork
 * behind a skewed crimson panel carrying the title and four selling points.
 * It was hard-coded to one project; this reads whichever project is flagged
 * `featured: true`, so promoting new work is a one-line edit.
 *
 * Renders nothing when no project is flagged.
 */
const featured = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)[0];

const media = featured?.data.media;
const backdrop = media?.type === 'image' ? (media.full ?? media.thumbnail) : undefined;
const href = featured && hasWriteup(featured.body) ? `/projects/${featured.id}/` : undefined;
const external = featured?.data.links.live ?? featured?.data.links.repo;
const link = href ?? external;
---

{featured && (
  <section class="showbox" aria-labelledby="featured-title">
    {backdrop && (
      <Image
        class="backdrop"
        src={backdrop}
        alt=""
        widths={[900, 1600]}
        sizes="100vw"
        loading="lazy"
      />
    )}

    <div class="panel">
      <div class="inner">
        <p class="eyebrow">Featured project</p>
        <h2 id="featured-title">{featured.data.title}</h2>

        {featured.data.summary && <p class="summary">{featured.data.summary}</p>}

        {featured.data.featureHighlights.length > 0 && (
          <ul class="points" role="list">
            {featured.data.featureHighlights.map((point) => (
              <li>
                <Icon name={point.icon} aria-hidden="true" />
                <div>
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              </li>
            ))}
          </ul>
        )}

        {link && (
          <p class="cta">
            <a href={link} rel={href ? undefined : 'noopener'}>
              {href ? 'Read more' : 'View project'}
            </a>
          </p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .showbox {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-dark-deep);
    margin-bottom: var(--section-padding-y);
    min-height: clamp(28rem, 55vw, 44rem);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /*
    The original drew this wedge with a 1021px border triangle. A clip-path
    does the same job and actually scales.
  */
  .panel {
    position: relative;
    width: min(56%, 40rem);
    align-self: stretch;
    display: flex;
    align-items: center;
    background: rgb(168 0 0 / 0.92);
    clip-path: polygon(clamp(3rem, 9vw, 16.25rem) 0, 100% 0, 100% 100%, 0 100%);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3.5rem)
             clamp(2.5rem, 6vw, 5rem) clamp(4rem, 11vw, 18rem);
    color: #fff;
  }

  .inner { display: flex; flex-direction: column; gap: 1rem; }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: 0.85;
  }

  h2 {
    font-size: clamp(1.6rem, 4vw, 2.8125rem);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .summary { font-size: 1rem; line-height: 1.6; opacity: 0.92; max-width: 34rem; }

  .points {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .points li { display: flex; gap: 1rem; align-items: flex-start; }

  .points [data-icon] { font-size: 1.6rem; flex: none; margin-top: 0.15rem; }

  .points h3 {
    font-size: 0.95rem;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .points p { font-size: 0.88rem; line-height: 1.55; opacity: 0.9; margin-top: 0.25rem; }

  .cta { margin-top: 0.75rem; }

  .cta a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-crimson);
    background: #fff;
    padding: 0.85rem 1.5rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .cta a:hover, .cta a:focus-visible { background: var(--color-ink); color: #fff; }

  @media (max-width: 52rem) {
    .showbox { min-height: 0; }

    .panel {
      width: 100%;
      clip-path: none;
      padding: clamp(2rem, 7vw, 3rem) clamp(1.25rem, 5vw, 2.5rem);
      background: rgb(168 0 0 / 0.95);
    }
  }
</style>
