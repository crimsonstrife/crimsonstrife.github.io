---
import BaseLayout from './BaseLayout.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
const updatedDate = new Date(`${updated}T00:00:00Z`);
const formattedUpdated = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(updatedDate);
---

<BaseLayout title={`${title} | ${site.name}`} description={description}>
  <article class="policy">
    <header>
      <p class="eyebrow">Site information</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="updated">Last updated <time datetime={updated}>{formattedUpdated}</time></p>
    </header>

    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .policy {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  header {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-rule);
  }

  header::after {
    content: '';
    display: block;
    width: clamp(4.5rem, 9vw, 8rem);
    height: 0.3rem;
    margin-top: 1.5rem;
    background: linear-gradient(90deg, var(--color-accent) 0 72%, var(--color-accent-warm) 72%);
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 100%, 0 100%);
  }

  .eyebrow {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.65rem;
    font-size: var(--size-section-header);
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .updated {
    margin-top: 1rem;
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .content { padding-top: 0.5rem; }

  .content :global(h2) {
    margin: 2.5rem 0 0.85rem;
    font-size: 1.25rem;
    text-transform: uppercase;
  }

  .content :global(h3) {
    margin: 1.75rem 0 0.65rem;
    font-size: 1rem;
  }

  .content :global(p) { margin-bottom: 1rem; }

  .content :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .content :global(li) { margin-bottom: 0.45rem; }

  .content :global(a) {
    color: var(--color-accent-dark);
    text-underline-offset: 0.18em;
  }

  .content :global(strong) { font-weight: 700; }
</style>
