---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import { includeDrafts } from '../../lib/content';

export const getStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => includeDrafts || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });

const shareImage = post.data.heroImage
  ? (await getImage({ src: post.data.heroImage, width: 1200 })).src
  : undefined;
---

<BaseLayout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  ogType="article"
  image={shareImage}
  imageAlt={post.data.title}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
>
  <article class="post">
    <header>
      <p class="date">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatter.format(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <span>Updated {formatter.format(post.data.updatedDate)}</span>
        )}
        {post.data.draft && <span class="draft">Draft</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>

    {post.data.heroImage && (
      <Image class="hero" src={post.data.heroImage} alt="" widths={[600, 1000]} loading="eager" />
    )}

    <div class="prose">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <ul class="tags" role="list">
        {post.data.tags.map((tag) => (
          <li><a href={`/blog/tags/${tag}/`}>{tag}</a></li>
        ))}
      </ul>
    )}

    <p class="back"><a href="/blog">← All posts</a></p>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  header { border-bottom: 3px solid var(--color-crimson); padding-bottom: 1.5rem; }

  .date {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .draft { color: var(--color-crimson); border: 1px solid currentColor; padding: 0.1rem 0.4rem; }

  h1 { font-size: clamp(1.75rem, 5vw, 2.75rem); text-transform: uppercase; margin-top: 0.75rem; }

  .lede { margin-top: 0.75rem; color: var(--color-muted); font-size: 1.05rem; }

  .hero { display: block; width: 100%; height: auto; margin-top: 2rem; }

  .tags { list-style: none; margin: 2.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .tags a {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--color-muted);
    background: var(--color-surface-sunk);
    border: 1px solid var(--color-rule);
    padding: 0.2rem 0.55rem;
    text-decoration: none;
  }

  .back { margin-top: 2.5rem; }

  .back a {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .back a:hover, .back a:focus-visible { text-decoration: underline; }
</style>
