---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message sent | Patrick Barnhardt"
  description="Your message to Patrick Barnhardt has been sent."
>
  <section class="thanks">
    <p class="kicker">Message sent</p>
    <h1>Thanks for reaching out.</h1>
    <p>I have your note and will get back to you at the email address you provided.</p>
    <a href="/#contact">Back to the homepage</a>
  </section>
</BaseLayout>

<style>
  .thanks {
    min-height: calc(100vh - var(--header-height));
    padding: clamp(6rem, 14vw, 10rem) var(--content-gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background:
      linear-gradient(rgb(251 250 247 / 0.94), rgb(251 250 247 / 0.94)),
      var(--color-accent-tint);
  }

  .kicker {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  h1 {
    max-width: 16ch;
    margin: 0.6rem 0 1rem;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  p:not(.kicker) {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.65;
  }

  a {
    margin-top: 2rem;
    padding: 0.9rem 1.35rem;
    color: #fff;
    background: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 100%, 0 100%);
  }

  a:hover,
  a:focus-visible { background: var(--color-ink); }
</style>
