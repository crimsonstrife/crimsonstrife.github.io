---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Gallery from '../../components/Gallery.astro';
import site from '../../data/site.json';
import { hasWriteup, readingTime } from '../../lib/content';

/**
 * Only projects with an actual write-up get a page. A project with an empty
 * body stays a tile in the gallery — add prose to the Markdown file and its
 * page appears on the next build.
 */
export const getStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => hasWriteup(project.body))
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { Content, headings } = await render(project);

const categories = await getCollection('categories');
const category = categories.find((c) => c.data.id === project.data.category);
const { media, caseStudy, gallery } = project.data;

/**
 * A case study earns the extra furniture: a reading estimate, a label, and —
 * only once there is enough structure to be worth navigating — a contents
 * list. Two headings is a page you just scroll.
 */
const minutes = caseStudy ? readingTime(project.body) : null;
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = caseStudy && contents.length >= 3;
---

<BaseLayout
  title={`${project.data.title} | ${site.name}`}
  description={project.data.summary || `${project.data.title} — work by ${site.name}.`}
>
  <article class:list={['project', { 'has-toc': showToc }]}>
    {showToc && <TableOfContents headings={contents} />}

    <div class="column">
      <header>
        {category && <p class="category">{category.data.label}</p>}
        <h1>{project.data.title}</h1>

        {caseStudy && (
          <p class="meta">
            <span class="badge">Case study</span>
            <span class="dot" aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </p>
        )}

        {project.data.summary && <p class="lede">{project.data.summary}</p>}

        {(project.data.links.repo || project.data.links.live || project.data.links.download) && (
          <p class="links">
            {project.data.links.repo && (
              <a href={project.data.links.repo} rel="noopener">Source</a>
            )}
            {project.data.links.live && (
              <a href={project.data.links.live} rel="noopener">View live</a>
            )}
            {project.data.links.download && (
              <a href={project.data.links.download} rel="noopener">Download</a>
            )}
          </p>
        )}
      </header>

      {media && (
        <div class="media">
          {media.type === 'image' && (
            <Image src={media.full ?? media.thumbnail} alt={project.data.title} widths={[600, 1200]} />
          )}
          {media.type === 'youtube' && (
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${media.videoId}`}
              title={project.data.title}
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          )}
          {media.type === 'sketchfab' && (
            <iframe
              src={`https://sketchfab.com/models/${media.modelId}/embed`}
              title={project.data.title}
              allow="autoplay; fullscreen; xr-spatial-tracking"
              allowfullscreen
              loading="lazy"
            />
          )}
        </div>
      )}

      {project.data.imageCredit && (
        <p class="credit">
          {project.data.imageCredit.role ?? 'Artwork'} by{' '}
          {project.data.imageCredit.url ? (
            <a href={project.data.imageCredit.url} rel="noopener">{project.data.imageCredit.name}</a>
          ) : (
            project.data.imageCredit.name
          )}
        </p>
      )}

      <div class="prose">
        <Content />
      </div>

      {gallery && (
        <Gallery items={gallery.items} title={gallery.title} groupId={project.id} />
      )}

      {project.data.tags.length > 0 && (
        <ul class="tags" role="list">
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}

      <p class="back"><a href="/#work">← All work</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 46rem;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 4vw, 2.25rem) var(--section-padding-y);
  }

  /*
   * With a contents list the container widens just enough to hold it beside
   * the article — the reading column itself stays 46rem either way.
   * 46rem prose + 16rem contents + 3rem gap = 65rem.
   */
  .project.has-toc {
    max-width: 65rem;
    display: grid;
    grid-template-columns: 16rem minmax(0, 46rem);
    column-gap: 3rem;
    align-items: start;
  }

  .project.has-toc > .column {
    grid-column: 2;
    min-width: 0;
  }

  /*
   * Below this the prose track would start shrinking under 46rem, so the grid
   * collapses and the contents list becomes the <details> above the article.
   * Keep in step with the breakpoint in TableOfContents.astro.
   */
  @media (max-width: 72rem) {
    .project.has-toc {
      max-width: 46rem;
      display: block;
    }
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  /* Quieter than .category on purpose — a second bold uppercase accent line
     directly under the title competes with it. */
  .meta .badge {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-dark);
    background: var(--color-accent-tint);
    border: 1px solid var(--color-accent);
    padding: 0.25rem 0.55rem;
  }

  .meta .dot { color: var(--color-rule); }

  .category {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-crimson);
  }

  h1 { font-size: clamp(1.75rem, 5vw, 2.75rem); text-transform: uppercase; margin-top: 0.6rem; }

  .lede { margin-top: 0.85rem; color: var(--color-muted); font-size: 1.05rem; }

  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }

  .links a {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-crimson);
    border: 2px solid var(--color-crimson);
    padding: 0.6rem 1.1rem;
    text-decoration: none;
  }

  .links a:hover, .links a:focus-visible { background: var(--color-crimson); color: #fff; }

  .media { margin-top: 2.25rem; background: var(--color-surface-sunk); }
  .media :global(img) { display: block; width: 100%; height: auto; }
  .media iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }

  .credit {
    margin-top: 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .credit a { color: var(--color-crimson); }

  .tags { list-style: none; margin: 2.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .tags li {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--color-muted);
    background: var(--color-surface-sunk);
    border: 1px solid var(--color-rule);
    padding: 0.2rem 0.55rem;
  }

  .back { margin-top: 2.5rem; }
  .back a {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-crimson);
  }
</style>
