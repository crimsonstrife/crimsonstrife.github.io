{
  "name": "patrickbarnhardt-info",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio and resume site for Patrick Barnhardt",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "contact:types": "wrangler types --config workers/contact/wrangler.jsonc workers/contact/worker-configuration.d.ts",
    "contact:check": "tsc --project workers/contact/tsconfig.json --noEmit",
    "contact:test": "vitest run --config workers/contact/vitest.config.ts",
    "contact:dev": "wrangler dev --config workers/contact/wrangler.jsonc",
    "contact:deploy": "wrangler deploy --config workers/contact/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "astro": "^7.2.9",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
